{
  "name": "dsh-skill-installer",
  "version": "0.3.0",
  "description": "DSH 技能安装器：在设置页里按工作区列出已装技能、从本地目录 / npm 包 / GitHub 仓库安装、按文件导入（.md / 目录 / zip / tar），并管理技能的启用停用与删除；一个下拉决定装到用户级 ~/.dsh/skills 还是某个工作区 <工作区>/.dsh/skills。同时给模型一个 skill_install 工具。",
  "license": "MIT",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "skill",
    "skills",
    "installer"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-tools": "^0.1.5-rc.2"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/liancha22/dsh-skill-installer.git"
  },
  "homepage": "https://github.com/liancha22/dsh-skill-installer#readme",
  "bugs": {
    "url": "https://github.com/liancha22/dsh-skill-installer/issues"
  },
  "author": "liancha22 <1784351702@qq.com>"
}
